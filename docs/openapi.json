              }
            }
          }
        }
      }
    },
    "/{full_path}": {
      "get": {
        "summary": "Spa Fallback",
        "description": "Return index.html for all non-API paths (React Router handles routing).",
        "operationId": "spa_fallback__full_path__get",
        "parameters": [
          {
            "name": "full_path",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Full Path"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "text/html": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AuthResponse": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "avatar": {
            "type": "string",
            "title": "Avatar"
          },
          "signature": {
            "type": "string",
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "message",
          "user_id",
          "avatar",
          "signature"
        ],
        "title": "AuthResponse"
      },
      "BookContentResponse": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "content": {
            "type": "string",
            "title": "Content"
          }
        },
        "type": "object",
        "required": [
          "title",
          "author",
          "content"
        ],
        "title": "BookContentResponse"
      },
      "BookListResponse": {
        "properties": {
          "books": {
            "items": {
              "$ref": "#/components/schemas/BookOut"
            },
            "type": "array",
            "title": "Books"
          }
        },
        "type": "object",
        "required": [
          "books"
        ],
        "title": "BookListResponse"
      },
      "BookOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "author": {
            "type": "string",
            "title": "Author"
          },
          "progress": {
            "type": "integer",
            "title": "Progress"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "author",
          "progress"
        ],
        "title": "BookOut"
      },
      "ChatRequest": {
        "properties": {
          "message": {
            "type": "string",
            "title": "Message"
          },
          "user_id": {
            "type": "string",
            "title": "User Id",
            "default": ""
          },
          "book_context": {
            "type": "string",
            "title": "Book Context",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "message"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "response": {
            "type": "string",
            "title": "Response"
          }
        },
        "type": "object",
        "required": [
          "response"
        ],
        "title": "ChatResponse"
      },
      "CurrentBookResponse": {
        "properties": {
          "book_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Book Id"
          },
          "title": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Title"
          },
          "author": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Author"
          }
        },
        "type": "object",
        "required": [
          "book_id"
        ],
        "title": "CurrentBookResponse"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RegisterRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "minLength": 1,
            "title": "Password"
          },
          "signature": {
            "type": "string",
            "title": "Signature",
            "default": "这个人很懒，什么都没写"
          },
          "avatar": {
            "type": "string",
            "title": "Avatar",
            "default": "default_avatar_1.svg"
          }
        },
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "UpdateCurrentBookRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "book_id": {
            "type": "string",
            "title": "Book Id"
          },
          "progress": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Progress"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "book_id"
        ],
        "title": "UpdateCurrentBookRequest"
      },
      "UploadRequest": {
        "properties": {
          "user_id": {
            "type": "string",
            "title": "User Id"
          },
          "filename": {
            "type": "string",
            "title": "Filename"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "author": {
            "type": "string",
            "title": "Author",
            "default": "Unknown"
          }
        },
        "type": "object",
        "required": [
          "user_id",
          "filename",
          "content"
        ],
        "title": "UploadRequest"
      },
      "UserProfileResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          },
          "avatar": {
            "type": "string",
            "title": "Avatar"
          },
          "signature": {
            "type": "string",
            "title": "Signature"
          }
        },
        "type": "object",
        "required": [
          "username",
          "avatar",
          "signature"
        ],
        "title": "UserProfileResponse"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}
