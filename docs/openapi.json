        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BookContentResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
