{
  "$schema": "https://biomejs.dev/schemas/1.9.0/schema.json",
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true
    }
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double"
    }
  },
  "files": {
    "ignore": [
      "node_modules",
      "dist",
      "src/api/generated",
      "vite.config.js",
      "vite.config.d.ts",
      "tsconfig.tsbuildinfo",
      "tsconfig.node.tsbuildinfo",
      "src/styles/index.css"
    ]
  }
}
